# Qulo — App Store Connect / TestFlight deploy (fastlane)
#
# Neden: iOS tarafinda deploy_testflight.sh vardi ama zincirin yarisiydi —
# build alip yukluyor, release notlarina hic dokunmuyordu. 16 dillik
# "What to Test" ve App Store "Yenilikler" metinleri elle, ayri node
# scriptleriyle gonderiliyordu ve cogu zaman unutuluyordu. Android tarafinda
# `fastlane android ship_internal` tek komutla yaparken iOS'ta yapmiyordu.
#
# Release notlarinin tek kaynagi: scripts/testflight_release_notes.json
# (Ayni dosyayi Android changelog'lari da kullaniyor — iki magaza tek metin.)
#
# NOT: fastlane UTF-8 locale ister. Kabuğunda yoksa:
#   export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

default_platform(:ios)

FLUTTER_ROOT = File.expand_path("../..", __dir__)
IPA_PATH = File.join(FLUTTER_ROOT, "build/ios/ipa/Qulo.ipa")
API_BASE_URL = ENV["API_BASE_URL"] || "https://qulo-server-production.up.railway.app/api/v1"
BUNDLE_ID = "com.wordpress.calikusuberkant.qulorelease"

platform :ios do
  desc "pubspec.yaml'dan surum bilgisini oku"
  lane :version_info do
    pubspec = File.read(File.join(FLUTTER_ROOT, "pubspec.yaml"))
    line = pubspec[/^version:\s*(.+)$/, 1].strip
    name, build = line.split("+")
    UI.message("Surum: #{name} (build #{build})")
    { name: name, build: build }
  end

  desc "Surum App Store Connect'te build kabul ediyor mu — BUILD ALMADAN ONCE"
  lane :preflight do
    load_env!
    ensure_key!
    info = version_info
    Dir.chdir(FLUTTER_ROOT) do
      # Cikis 1 ise script sebebi zaten yaziyor; fastlane'i orada durdur.
      unless system("node scripts/asc_version_state.mjs #{info[:name]}")
        UI.user_error!("#{info[:name]} surumu build kabul etmiyor — yukaridaki cikti sebebi yaziyor.")
      end
    end
  end

  desc "IPA uret (release, prod API)"
  lane :build_ipa do
    Dir.chdir(FLUTTER_ROOT) do
      sh("fvm flutter build ipa --release --dart-define=API_BASE_URL=#{API_BASE_URL}")
    end
    UI.user_error!("IPA bulunamadi: #{IPA_PATH}") unless File.exist?(IPA_PATH)
    UI.success("IPA: #{IPA_PATH}")
  end

  desc "IPA'yi TestFlight'a yukle"
  lane :beta do
    load_env!
    ensure_key!
    UI.user_error!("IPA yok, once `fastlane ios build_ipa`") unless File.exist?(IPA_PATH)

    # skip_waiting_for_build_processing: false — notlari yazabilmek icin build'in
    # ASC'de islenmis olmasi lazim. Beklemezsek `notes` lane'i build'i bulamaz.
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
    )
  end

  desc "TestFlight 'What to Test' notlarini 16 dilde yaz"
  lane :notes do
    load_env!
    ensure_key!
    info = version_info
    Dir.chdir(FLUTTER_ROOT) do
      # Scriptin varsayilan bundle id'si baska bir uygulamayi gosteriyor —
      # her zaman acikca gec.
      sh({
        "IOS_BUNDLE_ID" => BUNDLE_ID,
        "IOS_VERSION" => info[:name],
        "IOS_BUILD_NUMBER" => info[:build],
      }, "node scripts/push_testflight_notes.mjs")
    end
  end

  desc "App Store 'Yenilikler' metnini tum lokalizasyonlara yaz"
  lane :whatsnew do
    load_env!
    ensure_key!
    Dir.chdir(FLUTTER_ROOT) do
      sh({ "IOS_BUNDLE_ID" => BUNDLE_ID }, "node scripts/push_appstore_whatsnew.mjs")
    end
    UI.important("Metinler yazildi. Incelemeye gonderme ADIMI DAHIL DEGIL —")
    UI.important("App Store Connect'ten build'i secip 'Incelemeye Gonder' demen gerekiyor.")
  end

  desc "Tam akis: preflight -> IPA build -> TestFlight -> 16 dil not"
  lane :ship_beta do
    preflight
    build_ipa
    beta
    notes
  end

  # ── Yardimcilar ──

  # Sirlar .env'de duruyor (deploy_testflight.sh de oradan okuyor). fastlane
  # kendiliginden yuklemiyor, elle aliyoruz.
  def load_env!
    path = File.join(FLUTTER_ROOT, ".env")
    return unless File.exist?(path)
    File.readlines(path).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#") || !line.include?("=")
      key, value = line.split("=", 2)
      ENV[key.strip] ||= value.strip.gsub(/\A["']|["']\z/, "")
    end
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_API_KEY"],
      issuer_id: ENV["APP_STORE_API_ISSUER"],
      key_filepath: key_path,
      in_house: false,
    )
  end

  def key_path
    File.expand_path("~/.private_keys/AuthKey_#{ENV['APP_STORE_API_KEY']}.p8")
  end

  # Anahtar yoksa hem fastlane hem node scriptleri anlasilmasi zor hata veriyor;
  # erken ve net patlat.
  def ensure_key!
    load_env!
    if ENV["APP_STORE_API_KEY"].to_s.empty? || ENV["APP_STORE_API_ISSUER"].to_s.empty?
      UI.user_error!(".env icinde APP_STORE_API_KEY ve APP_STORE_API_ISSUER tanimli olmali")
    end
    return if File.exist?(key_path)

    UI.user_error!(<<~MSG)
      App Store Connect API anahtari bulunamadi: #{key_path}

      Olusturma adimlari:
        1. App Store Connect > Users and Access > Integrations > App Store Connect API
        2. "App Manager" yetkisiyle anahtar olustur, .p8 dosyasini indir
        3. ~/.private_keys/ altina koy (dosya adi AuthKey_<KEYID>.p8 olmali)
        4. Key ID ve Issuer ID'yi .env'e yaz

      DIKKAT: deploy_testflight.sh ~/private_keys/ (noktasiz), node scriptleri
      ~/.private_keys/ (noktali) okuyor. Ikisinde de bulunmasi gerekebilir.
    MSG
  end
end
