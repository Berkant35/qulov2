"CFBundleDisplayName" = "Qulo";
"NSCameraUsageDescription" = "يلزم الوصول إلى الكاميرا لالتقاط صور الملف الشخصي.";
"NSPhotoLibraryUsageDescription" = "يلزم الوصول إلى مكتبة الصور لاختيار صور الملف الشخصي.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "يستخدم Qulo موقعك للعثور على أشخاص ضمن المسافة التي تختارها في شاشة Discover ولعرض مدينتك في ملفك الشخصي. على سبيل المثال، عند ضبط المسافة على 50 كم، تعرض شاشة Discover المستخدمين ضمن هذا النطاق، وتظهر في كل بطاقة المدينة والمسافة مثل \"دبي · 2.5 كم\".";
"NSLocationWhenInUseUsageDescription" = "يستخدم Qulo موقعك للعثور على أشخاص ضمن المسافة التي تختارها في شاشة Discover ولعرض مدينتك في ملفك الشخصي. على سبيل المثال، عند ضبط المسافة على 50 كم، تعرض شاشة Discover المستخدمين ضمن هذا النطاق، وتظهر في كل بطاقة المدينة والمسافة مثل \"دبي · 2.5 كم\".";
"NSMicrophoneUsageDescription" = "يلزم الوصول إلى الميكروفون لإرسال الرسائل الصوتية.";
"NSUserTrackingUsageDescription" = "يستخدم Qulo هذا المعرّف لعرض إعلانات أكثر ملاءمة لك، وقياس أداء الإعلانات (مثل معرفة أنك اكتشفت Qulo عبر إعلان)، وتحسين تجربتك في التطبيق. إذا رفضت، سيعمل Qulo بالطريقة نفسها وقد تظل ترى إعلانات، لكنها ستكون أقل تخصيصًا.";
