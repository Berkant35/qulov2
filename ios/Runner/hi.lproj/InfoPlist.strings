"CFBundleDisplayName" = "Qulo";
"CAMERA_USAGE_DESCRIPTION" = "प्रोफ़ाइल फ़ोटो लेने के लिए कैमरा एक्सेस आवश्यक है।";
"PHOTO_LIBRARY_DESCRIPTION" = "प्रोफ़ाइल फ़ोटो चुनने के लिए फ़ोटो लाइब्रेरी एक्सेस आवश्यक है।";
"LOCATION_WHEN_IN_USE_DESCRIPTION" = "Qulo आपके स्थान का उपयोग Discover स्क्रीन पर आपकी चुनी हुई दूरी के भीतर लोगों को ढूँढने और आपकी प्रोफ़ाइल पर आपके शहर को दिखाने के लिए करता है। उदाहरण के लिए, दूरी 50 किमी पर सेट करने पर Discover उस दायरे के उपयोगकर्ताओं को दिखाता है और हर कार्ड पर शहर और दूरी प्रदर्शित होती है, जैसे \"मुंबई · 2.5 किमी\"।";
"MICROPHONE_USAGE_DESCRIPTION" = "वॉइस मैसेज भेजने के लिए माइक्रोफ़ोन एक्सेस आवश्यक है।";
"TRACKING_USAGE_DESCRIPTION" = "Qulo व्यक्तिगत सामग्री प्रदान करने और आपके अनुभव को बेहतर बनाने के लिए इस पहचानकर्ता का उपयोग करता है। आपका डेटा विज्ञापन उद्देश्यों के लिए तीसरे पक्ष के साथ साझा नहीं किया जाता है।";
