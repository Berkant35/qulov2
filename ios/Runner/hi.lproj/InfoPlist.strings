"CFBundleDisplayName" = "Qulo";
"NSCameraUsageDescription" = "प्रोफ़ाइल फ़ोटो लेने के लिए कैमरा एक्सेस आवश्यक है।";
"NSPhotoLibraryUsageDescription" = "प्रोफ़ाइल फ़ोटो चुनने के लिए फ़ोटो लाइब्रेरी एक्सेस आवश्यक है।";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Qulo आपके स्थान का उपयोग Discover स्क्रीन पर आपकी चुनी हुई दूरी के भीतर लोगों को ढूँढने और आपकी प्रोफ़ाइल पर आपके शहर को दिखाने के लिए करता है। उदाहरण के लिए, दूरी 50 किमी पर सेट करने पर Discover उस दायरे के उपयोगकर्ताओं को दिखाता है और हर कार्ड पर शहर और दूरी प्रदर्शित होती है, जैसे \"मुंबई · 2.5 किमी\"।";
"NSLocationWhenInUseUsageDescription" = "Qulo आपके स्थान का उपयोग Discover स्क्रीन पर आपकी चुनी हुई दूरी के भीतर लोगों को ढूँढने और आपकी प्रोफ़ाइल पर आपके शहर को दिखाने के लिए करता है। उदाहरण के लिए, दूरी 50 किमी पर सेट करने पर Discover उस दायरे के उपयोगकर्ताओं को दिखाता है और हर कार्ड पर शहर और दूरी प्रदर्शित होती है, जैसे \"मुंबई · 2.5 किमी\"।";
"NSMicrophoneUsageDescription" = "वॉइस मैसेज भेजने के लिए माइक्रोफ़ोन एक्सेस आवश्यक है।";
"NSUserTrackingUsageDescription" = "Qulo इस आइडेंटिफ़ायर का उपयोग आपको अधिक प्रासंगिक विज्ञापन दिखाने, विज्ञापन के प्रदर्शन को मापने (जैसे यह जानना कि आपने Qulo को किसी विज्ञापन से खोजा) और आपके ऐप अनुभव को बेहतर बनाने के लिए करता है। यदि आप मना करते हैं, तो Qulo पहले की तरह ही काम करेगा और आपको विज्ञापन दिख सकते हैं, पर कम वैयक्तिकृत।";
